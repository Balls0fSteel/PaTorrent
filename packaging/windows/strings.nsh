; -- PaTorrent's window is open, or patorrent.exe is busy (another user's session)
LangString PT_RUNNING ${LANG_ENGLISH} "PaTorrent is running. Exit it (File > Exit), then click Retry."
LangString PT_RUNNING ${LANG_ARABIC} "PaTorrent قيد التشغيل. أغلقه (ملف > خروج)، ثم انقر «إعادة المحاولة»."
LangString PT_RUNNING ${LANG_BULGARIAN} "PaTorrent работи. Затворете го (Файл > Изход), след това щракнете „Повторен опит“."
LangString PT_RUNNING ${LANG_CATALAN} "PaTorrent s'està executant. Tanqueu-lo (Fitxer > Surt) i feu clic a «Torna-ho a provar»."
LangString PT_RUNNING ${LANG_CZECH} "PaTorrent je spuštěný. Ukončete jej (Soubor > Konec) a klepněte na Opakovat."
LangString PT_RUNNING ${LANG_DANISH} "PaTorrent kører. Afslut det (Filer > Afslut), og klik derefter på Prøv igen."
LangString PT_RUNNING ${LANG_GERMAN} "PaTorrent läuft. Beenden Sie es (Datei > Beenden) und klicken Sie dann auf „Wiederholen“."
LangString PT_RUNNING ${LANG_GREEK} "Το PaTorrent εκτελείται. Κλείστε το (Αρχείο > Έξοδος) και πατήστε «Επανάληψη»."
LangString PT_RUNNING ${LANG_SPANISH} "PaTorrent se está ejecutando. Ciérrelo (Archivo > Salir) y haga clic en Reintentar."
LangString PT_RUNNING ${LANG_FARSI} "PaTorrent در حال اجراست. آن را ببندید (پرونده > خروج) و سپس «تلاش دوباره» را بزنید."
LangString PT_RUNNING ${LANG_FINNISH} "PaTorrent on käynnissä. Lopeta se (Tiedosto > Lopeta) ja valitse sitten Yritä uudelleen."
LangString PT_RUNNING ${LANG_FRENCH} "PaTorrent est en cours d'exécution. Quittez-le (Fichier > Quitter), puis cliquez sur Recommencer."
LangString PT_RUNNING ${LANG_HEBREW} "PaTorrent פועל. צאו ממנו (קובץ > יציאה) ולחצו על „נסה שוב“."
LangString PT_RUNNING ${LANG_CROATIAN} "PaTorrent je pokrenut. Zatvorite ga (Datoteka > Izlaz), a zatim kliknite Pokušaj ponovno."
LangString PT_RUNNING ${LANG_HUNGARIAN} "A PaTorrent fut. Lépjen ki belőle (Fájl > Kilépés), majd kattintson az Ismét gombra."
LangString PT_RUNNING ${LANG_INDONESIAN} "PaTorrent sedang berjalan. Tutup (Berkas > Keluar), lalu klik Coba Lagi."
LangString PT_RUNNING ${LANG_ITALIAN} "PaTorrent è in esecuzione. Chiudilo (File > Esci), poi fai clic su Riprova."
LangString PT_RUNNING ${LANG_JAPANESE} "PaTorrent が実行中です。終了してから ([ファイル] > [終了])、[再試行] をクリックしてください。"
LangString PT_RUNNING ${LANG_KOREAN} "PaTorrent가 실행 중입니다. 종료한 다음(파일 > 끝내기) [다시 시도]를 클릭하십시오."
LangString PT_RUNNING ${LANG_NORWEGIAN} "PaTorrent kjører. Avslutt det (Fil > Avslutt), og klikk deretter Prøv på nytt."
LangString PT_RUNNING ${LANG_DUTCH} "PaTorrent is actief. Sluit het af (Bestand > Afsluiten) en klik dan op Opnieuw."
LangString PT_RUNNING ${LANG_POLISH} "PaTorrent jest uruchomiony. Zamknij go (Plik > Zakończ), a następnie kliknij Ponów próbę."
LangString PT_RUNNING ${LANG_PORTUGUESEBR} "O PaTorrent está em execução. Feche-o (Arquivo > Sair) e clique em Repetir."
LangString PT_RUNNING ${LANG_PORTUGUESE} "O PaTorrent está em execução. Feche-o (Ficheiro > Sair) e clique em Repetir."
LangString PT_RUNNING ${LANG_ROMANIAN} "PaTorrent rulează. Închideți-l (Fișier > Ieșire), apoi faceți clic pe Reîncercare."
LangString PT_RUNNING ${LANG_RUSSIAN} "PaTorrent запущен. Закройте его (Файл > Выход) и нажмите «Повтор»."
LangString PT_RUNNING ${LANG_SLOVAK} "PaTorrent je spustený. Ukončite ho (Súbor > Koniec) a kliknite na Opakovať."
LangString PT_RUNNING ${LANG_SERBIAN} "PaTorrent је покренут. Затворите га (Датотека > Излаз), па кликните „Покушај поново“."
LangString PT_RUNNING ${LANG_SWEDISH} "PaTorrent körs. Avsluta programmet (Arkiv > Avsluta) och klicka sedan på Försök igen."
LangString PT_RUNNING ${LANG_THAI} "PaTorrent กำลังทำงานอยู่ ปิดโปรแกรม (แฟ้ม > ออก) แล้วคลิก ลองใหม่"
LangString PT_RUNNING ${LANG_TURKISH} "PaTorrent çalışıyor. Programdan çıkın (Dosya > Çıkış), sonra Yeniden Dene'ye tıklayın."
LangString PT_RUNNING ${LANG_UKRAINIAN} "PaTorrent запущено. Закрийте його (Файл > Вихід) і натисніть «Повторити»."
LangString PT_RUNNING ${LANG_VIETNAMESE} "PaTorrent đang chạy. Hãy thoát (Tệp > Thoát), rồi nhấn Thử lại."
LangString PT_RUNNING ${LANG_SIMPCHINESE} "PaTorrent 正在运行。请退出它（文件 > 退出），然后单击“重试”。"
LangString PT_RUNNING ${LANG_TRADCHINESE} "PaTorrent 正在執行。請結束它（檔案 > 結束），然後按一下「重試」。"

; -- patorrent-nox.exe in the installation folder is busy (the service, or a console)
LangString PT_NOX_RUNNING ${LANG_ENGLISH} "patorrent-nox.exe is running from $INSTDIR, perhaps as the PaTorrent nox service. Stop it (as administrator: sc stop PaTorrentNox), then click Retry."
LangString PT_NOX_RUNNING ${LANG_ARABIC} "patorrent-nox.exe قيد التشغيل من $INSTDIR، ربما كخدمة PaTorrent nox. أوقفه (كمسؤول: sc stop PaTorrentNox)، ثم انقر «إعادة المحاولة»."
LangString PT_NOX_RUNNING ${LANG_BULGARIAN} "patorrent-nox.exe работи от $INSTDIR, може би като услугата PaTorrent nox. Спрете го (като администратор: sc stop PaTorrentNox), след това щракнете „Повторен опит“."
LangString PT_NOX_RUNNING ${LANG_CATALAN} "patorrent-nox.exe s'està executant des de $INSTDIR, potser com a servei PaTorrent nox. Atureu-lo (com a administrador: sc stop PaTorrentNox) i feu clic a «Torna-ho a provar»."
LangString PT_NOX_RUNNING ${LANG_CZECH} "patorrent-nox.exe běží z $INSTDIR, možná jako služba PaTorrent nox. Zastavte jej (jako správce: sc stop PaTorrentNox) a klepněte na Opakovat."
LangString PT_NOX_RUNNING ${LANG_DANISH} "patorrent-nox.exe kører fra $INSTDIR, måske som tjenesten PaTorrent nox. Stop det (som administrator: sc stop PaTorrentNox), og klik derefter på Prøv igen."
LangString PT_NOX_RUNNING ${LANG_GERMAN} "patorrent-nox.exe läuft aus $INSTDIR, vielleicht als Dienst „PaTorrent nox“. Beenden Sie es (als Administrator: sc stop PaTorrentNox) und klicken Sie dann auf „Wiederholen“."
LangString PT_NOX_RUNNING ${LANG_GREEK} "Το patorrent-nox.exe εκτελείται από το $INSTDIR, ίσως ως υπηρεσία PaTorrent nox. Σταματήστε το (ως διαχειριστής: sc stop PaTorrentNox) και πατήστε «Επανάληψη»."
LangString PT_NOX_RUNNING ${LANG_SPANISH} "patorrent-nox.exe se está ejecutando desde $INSTDIR, quizá como el servicio PaTorrent nox. Deténgalo (como administrador: sc stop PaTorrentNox) y haga clic en Reintentar."
LangString PT_NOX_RUNNING ${LANG_FARSI} "patorrent-nox.exe از $INSTDIR در حال اجراست، شاید به‌عنوان سرویس PaTorrent nox. آن را متوقف کنید (به‌عنوان مدیر: sc stop PaTorrentNox) و سپس «تلاش دوباره» را بزنید."
LangString PT_NOX_RUNNING ${LANG_FINNISH} "patorrent-nox.exe on käynnissä kansiosta $INSTDIR, ehkä PaTorrent nox -palveluna. Pysäytä se (järjestelmänvalvojana: sc stop PaTorrentNox) ja valitse sitten Yritä uudelleen."
LangString PT_NOX_RUNNING ${LANG_FRENCH} "patorrent-nox.exe s'exécute depuis $INSTDIR, peut-être en tant que service PaTorrent nox. Arrêtez-le (en administrateur : sc stop PaTorrentNox), puis cliquez sur Recommencer."
LangString PT_NOX_RUNNING ${LANG_HEBREW} "patorrent-nox.exe פועל מתוך $INSTDIR, אולי כשירות PaTorrent nox. עצרו אותו (כמנהל: sc stop PaTorrentNox) ולחצו על „נסה שוב“."
LangString PT_NOX_RUNNING ${LANG_CROATIAN} "patorrent-nox.exe pokrenut je iz $INSTDIR, možda kao usluga PaTorrent nox. Zaustavite ga (kao administrator: sc stop PaTorrentNox), a zatim kliknite Pokušaj ponovno."
LangString PT_NOX_RUNNING ${LANG_HUNGARIAN} "A patorrent-nox.exe fut innen: $INSTDIR, talán PaTorrent nox szolgáltatásként. Állítsa le (rendszergazdaként: sc stop PaTorrentNox), majd kattintson az Ismét gombra."
LangString PT_NOX_RUNNING ${LANG_INDONESIAN} "patorrent-nox.exe sedang berjalan dari $INSTDIR, mungkin sebagai layanan PaTorrent nox. Hentikan (sebagai administrator: sc stop PaTorrentNox), lalu klik Coba Lagi."
LangString PT_NOX_RUNNING ${LANG_ITALIAN} "patorrent-nox.exe è in esecuzione da $INSTDIR, forse come servizio PaTorrent nox. Arrestalo (come amministratore: sc stop PaTorrentNox), poi fai clic su Riprova."
LangString PT_NOX_RUNNING ${LANG_JAPANESE} "patorrent-nox.exe が $INSTDIR から実行中です (PaTorrent nox サービスの可能性があります)。停止してから (管理者として: sc stop PaTorrentNox)、[再試行] をクリックしてください。"
LangString PT_NOX_RUNNING ${LANG_KOREAN} "patorrent-nox.exe가 $INSTDIR에서 실행 중입니다(PaTorrent nox 서비스일 수 있음). 중지한 다음(관리자로: sc stop PaTorrentNox) [다시 시도]를 클릭하십시오."
LangString PT_NOX_RUNNING ${LANG_NORWEGIAN} "patorrent-nox.exe kjører fra $INSTDIR, kanskje som tjenesten PaTorrent nox. Stopp den (som administrator: sc stop PaTorrentNox), og klikk deretter Prøv på nytt."
LangString PT_NOX_RUNNING ${LANG_DUTCH} "patorrent-nox.exe draait vanuit $INSTDIR, misschien als de service PaTorrent nox. Stop het (als beheerder: sc stop PaTorrentNox) en klik dan op Opnieuw."
LangString PT_NOX_RUNNING ${LANG_POLISH} "patorrent-nox.exe działa z folderu $INSTDIR, być może jako usługa PaTorrent nox. Zatrzymaj go (jako administrator: sc stop PaTorrentNox), a następnie kliknij Ponów próbę."
