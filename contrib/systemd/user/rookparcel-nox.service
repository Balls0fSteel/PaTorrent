# rookparcel-nox as a user service: runs as you, with your files (docs/DAEMON.md).
#
#   install -m 755 rookparcel-nox ~/.local/bin/
#   install -D -m 644 rookparcel-nox.service ~/.config/systemd/user/rookparcel-nox.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now rookparcel-nox
#   journalctl --user -u rookparcel-nox     (the Web UI's temporary password on the first start)
#   loginctl enable-linger "$USER"          (keep it running while you are logged out)
#
# The state and the config follow XDG: ~/.local/share/rookparcel/nox (resume data, DHT state)
# and ~/.config/rookparcel/nox (webui.json). Change the command line with
# `systemctl --user edit rookparcel-nox` (an empty ExecStart= first, then the new one).

[Unit]
Description=Rookparcel BitTorrent daemon (rookparcel-nox)
Documentation=https://github.com/Balls0fSteel/Rookparcel/blob/main/docs/DAEMON.md

[Service]
Type=notify
NotifyAccess=main
ExecStart=%h/.local/bin/rookparcel-nox run --save %h/Downloads --webui 127.0.0.1:8080
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
# what it writes is yours alone (webui.json holds the Web UI's password hash); downloads too,
# so loosen this (0022) if other users of this machine should read them
UMask=0077
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
